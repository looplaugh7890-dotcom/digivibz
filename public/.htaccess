# DIGIVIBZ - Hostinger (LiteSpeed/Apache) static hosting rules
# The app uses clean pathname routing (/about, /case-study/<slug>), so every
# unknown path must fall back to index.html — the SPA router then renders it.

# ---------- SPA fallback (clean URLs) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files/dirs win (fingerprinted /assets, robots.txt, favicon…)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Caching ----------
# Vite emits fingerprinted files under /assets/ — cache them hard.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------- Basic hardening ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve dotfiles (.env, .git, …)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

DirectoryIndex index.html
